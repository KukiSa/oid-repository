{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry release manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "releaseStatus", "publishedAt", "signatureRequiredForAuthoritativeRelease", "artifacts"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "releaseId": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"},
    "releaseStatus": {"enum": ["candidate", "authoritative", "superseded"]},
    "publishedAt": {"type": "string", "format": "date-time"},
    "signatureRequiredForAuthoritativeRelease": {"type": "boolean"},
    "signing": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "required": ["algorithm", "publicKeySpkiSha256", "signaturePath"], "properties": {
          "algorithm": {"const": "Ed25519"},
          "publicKeySpkiSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "signaturePath": {"const": "manifest.sig.json"}
        }, "additionalProperties": false}
      ]
    },
    "artifacts": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "scope": {"enum": ["package", "public"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
